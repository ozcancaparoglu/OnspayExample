# Copy to .env (git-ignored) and change as needed. docker compose reads .env automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onspay_example

RABBITMQ_USER=onspay
RABBITMQ_PASSWORD=onspay

# Ship ILogService logs (request/response, errors) to Elasticsearch from the containerised API.
ONSPAY_LOGGING_ENABLED=true
