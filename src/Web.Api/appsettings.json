{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=onspay_example;Username=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Quartz": "Warning"
      }
    }
  },
  "Onspay": {
    "Logging": {
      "Enabled": false,
      "RequestResponseEnabled": true,
      "ApplicationName": "onspay-example-service",
      "Environment": "development",
      "Address": "http://localhost:9200",
      "IndexName": "onspay-example-logs",
      "RequestResponseIndexName": "onspay-example-reqlog",
      "ConsoleOutput": false,
      "MaxBodyLength": 4096,
      "RedactedHeaders": [ "Authorization", "Cookie", "Set-Cookie", "x-api-key" ],
      "ExcludedPaths": [ "/health*", "/scalar*", "/openapi*" ]
    }
  },
  "Cqrs": {
    "Logging": {
      "Enabled": true
    }
  },
  "Cache": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "onspay-example:",
    "DefaultExpirationInMinutes": 60
  },
  "RabbitMq": {
    "Onspay": {
      "IsDefault": true,
      "AutoCreateTopology": true,
      "Host": "localhost",
      "Port": 5672,
      "Username": "onspay",
      "VirtualHost": "/",
      "Queues": {
        "OrderEvents": {
          "HasInbox": true,
          "HasDeadLetterExchange": true,
          "RequireTenantHeader": false,
          "ExchangeType": "direct",
          "Exchange": "onspay-example.order-events",
          "Queue": "onspay-example.order-events",
          "MaxRetryCount": 5,
          "RetryDelayMs": 10000
        }
      }
    }
  },
  "Outbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 100,
    "MaxRetryCount": 5,
    "RetryDelayInSeconds": 10
  },
  "Inbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 100,
    "MaxRetryCount": 5,
    "RetryDelayInSeconds": 10
  }
}
